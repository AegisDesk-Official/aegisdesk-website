# =====================================================================
# AegisDesk Environment Configuration (.env.example)
# Never commit real keys or production secrets to source control.
# Copy this file to .env.local for local development.
# =====================================================================

# 1. Public Application URLs & Links
NEXT_PUBLIC_APP_URL="https://aegisdesk.ai"
NEXT_PUBLIC_SITE_URL="https://aegisdesk.ai"
NEXT_PUBLIC_CAL_LINK="https://cal.com/aegis-desk-le98cq/15min"
NEXT_PUBLIC_CONTACT_EMAIL="hello@aegisdesk.ai"
NEXT_PUBLIC_LOOM_URL=""

# 2. Database & Multi-Tenant Isolation (Supabase)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"
# Server-only: Bypasses RLS for secure background workers and admin routes
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# 3. Payments & Billing (Razorpay Test & Live Mode)
# Pricing: Dynamic agreed setup fee (S) (50% deposit + 50% balance) + monthly retainer (M)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_hmac_secret"

# 4. Calendar Scheduling (Cal.com)
CALCOM_WEBHOOK_SECRET="your_cal_webhook_signing_secret"
CAL_WEBHOOK_SECRET="your_cal_webhook_signing_secret"
CALCOM_OWNER_NOTIFICATION_EMAIL="founder@aegisdesk.ai"

# 5. Transactional Email Delivery (Resend)
RESEND_API_KEY="re_your_resend_api_key"

# 6. Bot Mitigation & Honeypot (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAA...your_turnstile_site_key"
TURNSTILE_SECRET_KEY="0x4AAAAAA...your_turnstile_secret_key"

# 7. Distributed Cache & Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token"

# 8. Portal & Public Demo Controls
# Keep false until production launch / backend readiness
DASHBOARD_PREVIEW="false"
DEMO_ENABLED="false"
NEXT_PUBLIC_LIVE_TEST_ENABLED="false"
LIVE_TEST_ENABLED="false"
WORKBENCH_DAILY_SPEND_CAP_USD="10.00"
DEMO_DAILY_SPEND_CAP_USD="10.00"
DEMO_DAILY_GLOBAL_CAP="100"
DEMO_MONTHLY_CAP="1000"
CRON_SECRET="your_cron_worker_bearer_secret"
LEAD_WEBHOOK_URL=""

# 9. External AI Answering Engine Integration (docs/PIPELINE_CONTRACT.md)
# Keep PIPELINE_BASE_URL empty until the external engine is deployed and ready.
# While empty, all pipeline methods return typed NOT_CONNECTED errors cleanly.
PIPELINE_BASE_URL=""
PIPELINE_SHARED_SECRET="your_shared_secret_min_32_characters_random_key"
PIPELINE_WORKBENCH_ORG_ID="aegisdesk-workbench"
DOCUMENTS_BUCKET="client-documents"

# 10. AegisDesk Events API & Ingestion Secrets
EVENTS_API_DEFAULT_SECRET="sec_demo_aegis_key_001"

# 11. Error Telemetry & Observability (Sentry with PII Scrubbing)
SENTRY_DSN="https://placeholder-key@o000000.ingest.sentry.io/0000000"
NEXT_PUBLIC_SENTRY_DSN="https://placeholder-key@o000000.ingest.sentry.io/0000000"
ENCRYPTION_KEY="placeholder_32_byte_hex_encryption_key"

# 12. Operator Console & Authentication Gate
OWNER_EMAIL="owner@aegisdesk.ai"


